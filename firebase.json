{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "cal_crops/**",
      "scratch/**",
      "_backup_before_minimal/**",
      "dom_dump.txt",
      "shared_strings_utf8.txt",
      "excel_attendance_sample.json",
      "*.xlsx"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
